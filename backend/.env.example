# Copy to .env and fill in. Never commit .env.
APP_ENV=production
SECRET_KEY=change-me-long-random-string
APP_PASSWORD=change-me

# Option A: SQL Server with Windows auth
DATABASE_SERVER=localhost\SQLEXPRESS
DATABASE_NAME=multiwire

# Option B: SQL Server with a login (set both)
# DATABASE_USER=
# DATABASE_PASSWORD=

# Option C: any SQLAlchemy URL (overrides the above), e.g. a local SQLite file
# DATABASE_URL=sqlite:///multiwire.db

# PORT=8000
# COOKIE_SECURE=0   # only if serving plain http (not recommended)
